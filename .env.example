POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=

USE_PUSH_NOTIFICATIONS='true'
NOTIFICATION_WEBHOOK_URL=

# Strategy Options: 'QueueOnly', 'QueueAndLiveModeDelivery', 'DirectDelivery'
MESSAGE_FORWARDING_STRATEGY=

# Wallet DB Config
WALLET_DB_MAX_CONNECTIONS=10
WALLET_DB_MIN_CONNECTIONS=0
WALLET_DB_IDLE_TIMEOUT=0
WALLET_DB_CONNECT_TIMEOUT=10

LOG_LEVEL=

# Bearer token required to call POST /admin/log-level (runtime log-level toggle).
# Leave unset to disable the admin endpoint entirely.
ADMIN_TOKEN=

#  Enables the mediator's WebSocket ping/pong heartbeat that keeps idle mobile sockets alive through NAT/ALB idle timeouts. Default: true (active); set to false to disable.
WS_KEEPALIVE_ENABLED=
# How often (milliseconds) the mediator pings all connected sockets and terminates any that haven't responded since the last ping. Default: 30000 (30 s)
WS_KEEPALIVE_INTERVAL_MS=